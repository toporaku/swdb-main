	"item": [
		{
			"name": "1. Autenticación y Usuarios",
			"item": [
				{
					"name": "Iniciar Sesión como Administrador",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Inicio de sesión exitoso (Status 200)\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Retorna Token JWT\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    // Guardar token en variable de entorno",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"Password123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{gateway_url}}/auth-service/login",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"auth-service",
								"login"
							]
						},
						"description": "Autentica al administrador predeterminado y extrae el token JWT para peticiones posteriores."
					},
					"response": []
				},
